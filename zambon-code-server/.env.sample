# Optional overrides for Code Server.
#
# Copy to .env in this app's app-data directory on the Umbrel server:
#   ~/umbrel/app-data/zambon-code-server/.env
# or into the Work folder itself:
#   ~/umbrel/home/Work/.env
#
# Leave PASSWORD unset to keep code-server running with --auth none.
# Setting it turns the login screen back on.
#PASSWORD=
#HASHED_PASSWORD=
